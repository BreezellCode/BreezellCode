{
	"name": "starter-pack",
	"publisher": "breezell",
	"displayName": "Starter Pack",
	"description": "Code review and testing skills, short house rules, a thinking MCP server and a calm dark theme: no code.",
	"version": "1.0.1",
	"license": "MIT",
	"author": {
		"name": "Breezell",
		"url": "https://breezell.com"
	},
	"repository": "https://github.com/BreezellCode/BreezellCode/tree/main/plugins/examples/starter-pack",
	"icon": "media/icon.png",
	"engines": {
		"vscode": "^1.90.0"
	},
	"extensionKind": [
		"ui",
		"workspace"
	],
	"categories": [
		"Themes",
		"Other"
	],
	"keywords": [
		"skills",
		"rules",
		"mcp",
		"theme",
		"review",
		"testing"
	],
	"breezell": {
		"apiVersion": 1,
		"permissions": [],
		"source": "open"
	},
	"contributes": {
		"breezell": {
			"skills": [
				"skills"
			],
			"rules": [
				"rules/house-rules.md"
			],
			"mcpServers": {
				"sequential-thinking": {
					"command": "npx",
					"args": [
						"-y",
						"@modelcontextprotocol/server-sequential-thinking"
					]
				}
			}
		},
		"themes": [
			{
				"label": "Breezell Calm Dark",
				"uiTheme": "vs-dark",
				"path": "./themes/calm-dark.json"
			}
		]
	},
	"scripts": {
		"build": "node tools/breezell-plugin.mjs build",
		"validate": "node tools/breezell-plugin.mjs validate",
		"package:open": "node tools/breezell-plugin.mjs pack --open",
		"package:closed": "node tools/breezell-plugin.mjs pack --closed",
		"submit": "node tools/breezell-plugin.mjs submit"
	}
}
