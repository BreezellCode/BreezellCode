{
	"name": "chat-mirror",
	"publisher": "breezell",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "1.0.3",
	"license": "MIT",
	"author": {
		"name": "Breezell",
		"url": "https://breezell.com"
	},
	"repository": "https://github.com/BreezellCode/BreezellCode/tree/main/plugins/examples/chat-mirror",
	"icon": "media/icon.png",
	"engines": {
		"vscode": "^1.90.0"
	},
	"extensionKind": [
		"ui",
		"workspace"
	],
	"categories": [
		"Chat",
		"AI"
	],
	"keywords": [
		"chat",
		"conversation",
		"agent",
		"approve",
		"model",
		"window",
		"tools"
	],
	"main": "./dist/extension.js",
	"activationEvents": [
		"onCommand:chatMirror.open",
		"onStartupFinished"
	],
	"breezell": {
		"apiVersion": 1,
		"permissions": [
			"chat.read",
			"chat.send",
			"chat.approve",
			"models.select",
			"agent.tools"
		],
		"source": "open"
	},
	"contributes": {
		"breezell": {
			"windows": [
				{
					"id": "mirror",
					"title": "Chat Mirror",
					"entry": "window/index.html",
					"width": 1000,
					"height": 700,
					"minWidth": 640,
					"minHeight": 420
				}
			],
			"launcher": {
				"command": "chatMirror.open",
				"sidebar": true
			},
			"tools": [
				{
					"name": "pin_note",
					"displayName": "%tool.pinNote%",
					"description": "Pins a short note in the user's Chat Mirror window, beside their conversations, for them to read later: a summary, a decision, a next step or a reminder. Use it when the user asks to note, pin or keep something in Chat Mirror. Returns how many notes are pinned.",
					"modes": [
						"chat",
						"agent",
						"entanglement"
					],
					"inputSchema": {
						"type": "object",
						"properties": {
							"title": {
								"type": "string",
								"description": "A few words shown in bold above the note."
							},
							"text": {
								"type": "string",
								"description": "The note itself, plain text, at most 2,000 characters."
							}
						},
						"required": [
							"text"
						]
					}
				},
				{
					"name": "list_notes",
					"displayName": "%tool.listNotes%",
					"description": "Lists the notes pinned in the user's Chat Mirror window, newest first, with when each was pinned. Read-only. Use it when the user refers to their pinned notes.",
					"modes": [
						"chat",
						"agent",
						"entanglement",
						"analyze",
						"teams"
					],
					"inputSchema": {
						"type": "object",
						"properties": {}
					}
				}
			]
		},
		"commands": [
			{
				"command": "chatMirror.open",
				"title": "%command.open%",
				"category": "Chat Mirror"
			}
		]
	},
	"scripts": {
		"build": "node tools/breezell-plugin.mjs build",
		"watch": "node tools/breezell-plugin.mjs build --watch",
		"typecheck": "tsc -p .",
		"validate": "node tools/breezell-plugin.mjs validate",
		"package:open": "node tools/breezell-plugin.mjs pack --open",
		"package:closed": "node tools/breezell-plugin.mjs pack --closed",
		"submit": "node tools/breezell-plugin.mjs submit"
	},
	"devDependencies": {
		"@types/vscode": "^1.90.0",
		"esbuild": "^0.28.0",
		"typescript": "^5.6.0"
	}
}
