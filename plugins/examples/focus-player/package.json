{
	"name": "focus-player",
	"publisher": "breezell",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "1.0.4",
	"license": "MIT",
	"author": {
		"name": "Breezell",
		"url": "https://breezell.com"
	},
	"repository": "https://github.com/BreezellCode/BreezellCode/tree/main/plugins/examples/focus-player",
	"icon": "media/icon.png",
	"engines": {
		"vscode": "^1.90.0"
	},
	"extensionKind": [
		"ui",
		"workspace"
	],
	"categories": [
		"Productivity",
		"Fun"
	],
	"keywords": [
		"music",
		"focus",
		"ambient",
		"sound"
	],
	"main": "./dist/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"breezell": {
		"apiVersion": 1,
		"permissions": [
			"chat.events"
		],
		"source": "open"
	},
	"contributes": {
		"breezell": {
			"launcher": {
				"command": "focusPlayer.open",
				"sidebar": true
			}
		},
		"commands": [
			{
				"command": "focusPlayer.open",
				"title": "%command.open%",
				"category": "Focus Player"
			},
			{
				"command": "focusPlayer.toggle",
				"title": "%command.toggle%",
				"category": "Focus Player"
			},
			{
				"command": "focusPlayer.chooseFolder",
				"title": "%command.chooseFolder%",
				"category": "Focus Player"
			}
		],
		"configuration": {
			"title": "Focus Player",
			"properties": {
				"focusPlayer.chimeWhenTurnFinishes": {
					"type": "boolean",
					"default": true,
					"description": "%config.chime%"
				},
				"focusPlayer.playWhileAgentWorks": {
					"type": "boolean",
					"default": false,
					"description": "%config.auto%"
				},
				"focusPlayer.musicFolder": {
					"type": "string",
					"default": "",
					"description": "%config.folder%"
				}
			}
		}
	},
	"scripts": {
		"build": "node tools/breezell-plugin.mjs build",
		"watch": "node tools/breezell-plugin.mjs build --watch",
		"typecheck": "tsc -p .",
		"validate": "node tools/breezell-plugin.mjs validate",
		"package:open": "node tools/breezell-plugin.mjs pack --open",
		"package:closed": "node tools/breezell-plugin.mjs pack --closed",
		"submit": "node tools/breezell-plugin.mjs submit"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"@types/vscode": "^1.90.0",
		"esbuild": "^0.28.0",
		"typescript": "^5.6.0"
	}
}
