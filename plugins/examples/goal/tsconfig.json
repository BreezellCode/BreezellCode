{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"esModuleInterop": true,
		"noEmit": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"types": ["node", "vscode"]
	},
	"include": ["src", "page", "test", "types"],
	"exclude": ["test/dist", "test/chain"]
}
