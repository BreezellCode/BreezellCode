{
	"name": "doc-writer",
	"publisher": "breezell",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "1.0.5",
	"license": "MIT",
	"author": {
		"name": "Breezell",
		"url": "https://breezell.com"
	},
	"repository": "https://github.com/BreezellCode/BreezellCode/tree/main/plugins/examples/doc-writer",
	"icon": "media/icon.png",
	"engines": {
		"vscode": "^1.90.0"
	},
	"extensionKind": [
		"ui",
		"workspace"
	],
	"categories": [
		"Programming Languages",
		"Other"
	],
	"keywords": [
		"ai",
		"documentation",
		"comments",
		"explain"
	],
	"main": "./dist/extension.js",
	"activationEvents": [],
	"breezell": {
		"apiVersion": 1,
		"permissions": [
			"models.request"
		],
		"source": "open"
	},
	"contributes": {
		"commands": [
			{
				"command": "docWriter.writeDoc",
				"title": "%command.writeDoc%",
				"category": "Doc Writer"
			},
			{
				"command": "docWriter.explain",
				"title": "%command.explain%",
				"category": "Doc Writer"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "docWriter.writeDoc",
					"when": "editorHasSelection && !editorReadonly",
					"group": "1_modification@90"
				},
				{
					"command": "docWriter.explain",
					"when": "editorHasSelection",
					"group": "navigation@90"
				}
			]
		},
		"configuration": {
			"title": "Doc Writer",
			"properties": {
				"docWriter.language": {
					"type": "string",
					"default": "English",
					"description": "%config.language%"
				}
			}
		}
	},
	"scripts": {
		"build": "node tools/breezell-plugin.mjs build",
		"watch": "node tools/breezell-plugin.mjs build --watch",
		"typecheck": "tsc -p .",
		"validate": "node tools/breezell-plugin.mjs validate",
		"package:open": "node tools/breezell-plugin.mjs pack --open",
		"package:closed": "node tools/breezell-plugin.mjs pack --closed",
		"submit": "node tools/breezell-plugin.mjs submit"
	},
	"devDependencies": {
		"@types/vscode": "^1.90.0",
		"esbuild": "^0.28.0",
		"typescript": "^5.6.0"
	}
}
