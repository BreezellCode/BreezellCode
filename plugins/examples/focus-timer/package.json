{
	"name": "focus-timer",
	"publisher": "breezell",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "1.0.3",
	"license": "MIT",
	"author": {
		"name": "Breezell",
		"url": "https://breezell.com"
	},
	"repository": "https://github.com/BreezellCode/BreezellCode/tree/main/plugins/examples/focus-timer",
	"icon": "media/icon.png",
	"engines": {
		"vscode": "^1.90.0"
	},
	"extensionKind": [
		"ui",
		"workspace"
	],
	"categories": [
		"Productivity"
	],
	"keywords": [
		"pomodoro",
		"timer",
		"focus",
		"window"
	],
	"main": "./dist/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"breezell": {
		"apiVersion": 1,
		"permissions": [
			"chat.events"
		],
		"source": "open"
	},
	"contributes": {
		"breezell": {
			"windows": [
				{
					"id": "timer",
					"title": "Focus Timer",
					"entry": "window/index.html",
					"width": 380,
					"height": 560,
					"minWidth": 320,
					"minHeight": 460,
					"requiresEditor": false
				}
			],
			"launcher": {
				"window": "timer",
				"sidebar": true
			}
		},
		"commands": [
			{
				"command": "focusTimer.open",
				"title": "%command.open%",
				"category": "Focus Timer"
			}
		]
	},
	"scripts": {
		"build": "node tools/breezell-plugin.mjs build",
		"watch": "node tools/breezell-plugin.mjs build --watch",
		"typecheck": "tsc -p .",
		"validate": "node tools/breezell-plugin.mjs validate",
		"package:open": "node tools/breezell-plugin.mjs pack --open",
		"package:closed": "node tools/breezell-plugin.mjs pack --closed",
		"submit": "node tools/breezell-plugin.mjs submit"
	},
	"devDependencies": {
		"@types/vscode": "^1.90.0",
		"esbuild": "^0.28.0",
		"typescript": "^5.6.0"
	}
}
