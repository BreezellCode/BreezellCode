{
	"name": "{{name}}",
	"publisher": "{{publisher}}",
	"displayName": "{{displayName}}",
	"description": "{{description}}",
	"version": "0.1.0",
	"license": "MIT",
	"engines": { "vscode": "^1.90.0" },
	"extensionKind": ["ui", "workspace"],
	"categories": ["Other"],
	"keywords": [],
	"main": "./dist/extension.js",
	"activationEvents": ["onStartupFinished"],
	"breezell": {
		"apiVersion": {{apiVersion}},
		"permissions": ["chat.events"],
		"source": "{{source}}"
	},
	"contributes": {
		"breezell": {
			"windows": [
				{
					"id": "main",
					"title": "{{displayName}}",
					"entry": "window/index.html",
					"width": 420,
					"height": 560,
					"minWidth": 320,
					"minHeight": 360,
					"requiresEditor": false
				}
			],
			"launcher": { "window": "main", "sidebar": true }
		},
		"commands": [
			{ "command": "{{name}}.openWindow", "title": "{{displayName}}: Open Window" }
		]
	},
	"scripts": {
		"build": "node tools/breezell-plugin.mjs build",
		"watch": "node tools/breezell-plugin.mjs build --watch",
		"typecheck": "tsc -p .",
		"validate": "node tools/breezell-plugin.mjs validate",
		"package:open": "node tools/breezell-plugin.mjs pack --open",
		"package:closed": "node tools/breezell-plugin.mjs pack --closed",
		"submit": "node tools/breezell-plugin.mjs submit"
	},
	"devDependencies": {
		"@types/vscode": "^1.90.0",
		"esbuild": "^0.28.0",
		"typescript": "^5.6.0"
	}
}
